{
  "name": "coldlaunch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "STRATCOM // COLD LAUNCH — a 1983 strategic command game: terminal console, glowing vector war-room wall display (Electron or browser, multi-monitor), Gemini/Claude AI opponents and MCP",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "coldlaunch": "bin/coldlaunch.mjs"
  },
  "scripts": {
    "start": "tsx packages/cli/src/main.ts",
    "setup": "tsx packages/cli/src/setup.ts",
    "models": "tsx packages/cli/src/setup.ts --models",
    "web": "tsx packages/cli/src/main.ts --display browser",
    "server": "tsx packages/cli/src/main.ts --no-tui",
    "geo": "tsx packages/data/scripts/build-geo.ts",
    "gui": "npm run start -w @coldlaunch/gui",
    "gui:build": "npm run build -w @coldlaunch/gui",
    "sim": "tsx packages/cli/src/headless.ts",
    "mcp": "tsx packages/mcp/src/index.ts",
    "ai:smoke": "tsx packages/ai/src/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs": "tsx packages/cli/src/gen-docs.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "game",
    "wargame",
    "cold-war",
    "strategy",
    "terminal",
    "tui",
    "webgl",
    "electron",
    "gemini",
    "claude",
    "mcp",
    "vector-graphics",
    "retro"
  ]
}
